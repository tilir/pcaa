+// Fixed-point quantization for the pqbpaccel dumper below: three decimal
+// digits of precision (scale 1000), clamped to the same finite-cost bound
+// pqbpaccel's own solver computes for a graph of this size
+// (software/pbqp/pbqp.cpp's pbqp_max_finite_cost: (ACCEL_INF - 1) /
+// (node_count + edge_count), where ACCEL_INF is INT32_MAX / 4), with
+// +/-infinity mapped to the INF literal. This mirrors that function rather
+// than a project-independent guess so a dumped graph is always accepted by
+// pqbpaccel's own cost-range check.
+class PCAAPBQPCostQuantizer {
+public:
+  PCAAPBQPCostQuantizer(unsigned NumNodes, unsigned NumEdges)
+      : MaxFinite(computeMaxFinite(NumNodes, NumEdges)) {}
+
+  std::string quantize(PBQP::PBQPNum Value) {
+    if (std::isinf(Value))
+      return "INF";
+    constexpr double Scale = 1000.0;
+    double Scaled = std::round(static_cast<double>(Value) * Scale);
+    if (Scaled > static_cast<double>(MaxFinite)) {
+      Scaled = static_cast<double>(MaxFinite);
+      ++Clamped;
+    } else if (Scaled < -static_cast<double>(MaxFinite)) {
+      Scaled = -static_cast<double>(MaxFinite);
+      ++Clamped;
+    }
+    return std::to_string(static_cast<int64_t>(Scaled));
+  }
+
+  unsigned clampedCount() const { return Clamped; }
+
+private:
+  static int64_t computeMaxFinite(unsigned NumNodes, unsigned NumEdges) {
+    constexpr int64_t AccelInf = 2147483647LL / 4;
+    const int64_t Terms = static_cast<int64_t>(NumNodes) + NumEdges;
+    return Terms == 0 ? (AccelInf - 1) : (AccelInf - 1) / Terms;
+  }
+
+  int64_t MaxFinite;
+  unsigned Clamped = 0;
+};
+
+} // end anonymous namespace
+
+// Writes G in pqbpaccel's line-oriented .pbqp text format
+// (nodes N / node D c0..c(D-1) / edge i j <D_i*D_j costs, row-major>).
+// NodeId is a dense 0-based index for a freshly built graph (see
+// llvm/include/llvm/CodeGen/PBQP/Graph.h), so it is used directly as the
+// pqbpaccel node index. Returns the number of cost values that had to be
+// clamped to the finite-cost bound (see doc/llvm-corpus-characterization.md
+// in the pqbpaccel repo for observed rates).
+static unsigned writePCAAPBQPGraph(const PBQP::RegAlloc::PBQPRAGraph &G,
+                                    raw_ostream &OS) {
+  PCAAPBQPCostQuantizer Q(G.getNumNodes(), G.getNumEdges());
+  OS << "nodes " << G.getNumNodes() << "\n";
+  for (auto NId : G.nodeIds()) {
+    const PBQP::Vector &Costs = G.getNodeCosts(NId);
+    OS << "node " << Costs.getLength();
+    for (unsigned I = 0; I < Costs.getLength(); ++I)
+      OS << ' ' << Q.quantize(Costs[I]);
+    OS << "\n";
+  }
+  for (auto EId : G.edgeIds()) {
+    const PBQP::Matrix &M = G.getEdgeCosts(EId);
+    OS << "edge " << G.getEdgeNode1Id(EId) << ' ' << G.getEdgeNode2Id(EId);
+    for (unsigned R = 0; R < M.getRows(); ++R)
+      for (unsigned C = 0; C < M.getCols(); ++C)
+        OS << ' ' << Q.quantize(M[R][C]);
+    OS << "\n";
+  }
+  return Q.clampedCount();
+}
