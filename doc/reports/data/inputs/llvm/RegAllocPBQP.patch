+// Replaces path separators so a fully-qualified module.function name is safe
+// to use as a flat file name, and truncates+hashes names longer than common
+// filesystem limits (heavily templated C++ produces mangled names well past
+// 255 bytes; losing those graphs silently would bias the corpus toward
+// simpler code, so disambiguate with an FNV-1a hash instead of erroring).
+static std::string sanitizePCAAFileName(StringRef Name) {
+  std::string Result;
+  Result.reserve(Name.size());
+  for (char C : Name)
+    Result.push_back(C == '/' || C == '\\' ? '_' : C);
+  constexpr size_t MaxLength = 160;
+  if (Result.size() > MaxLength) {
+    uint64_t Hash = 1469598103934665603ULL; // FNV-1a offset basis
+    for (char C : Result) {
+      Hash ^= static_cast<unsigned char>(C);
+      Hash *= 1099511628211ULL; // FNV-1a prime
+    }
+    std::ostringstream Hex;
+    Hex << std::hex << Hash;
+    Result.resize(MaxLength);
+    Result += "_" + Hex.str();
+  }
+  return Result;
+}
